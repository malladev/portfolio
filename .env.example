# Copy to .env for local development. In production, set these in the Netlify
# dashboard (Site configuration > Environment variables): .env is never deployed.
# Keep the REACT_APP_ prefix away from these names, it would ship them to the browser.

# Required. Create one at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Sender. Must use a domain verified in Resend. Leave empty to use Resend's test
# sender, which can only deliver to the email address of the Resend account.
MAIL_FROM=Portfolio <contact@votre-domaine.com>

# Optional. Who receives the messages (defaults to the address shown on the site).
MAIL_TO=
